{
  "name": "otryad",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "test": "node --test packages/core/test/*.test.ts packages/server/test/*.test.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p packages/client",
    "dev": "npm run dev -w @otryad/client",
    "build": "npm run build -w @otryad/client",
    "balance": "node tools/balance.ts"
  },
  "engines": { "node": ">=22.18" },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/node": "22.10.2"
  }
}
